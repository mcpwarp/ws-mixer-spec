{
  "description": "3 streams open at once (from js/test/interop.test.ts's shape): server opens all three, then each is written to and read back independently. Commands are driven strictly in sequence by the pair DSL (see conformance/README.md's documented gap on true wire-concurrency), but all three streams stay live together throughout.",
  "steps": [
    { "actor": "server", "cmd": { "cmd": "open_stream" } },
    { "actor": "server", "await": { "event": "stream_opened", "id": 1 } },
    { "actor": "server", "cmd": { "cmd": "open_stream" } },
    { "actor": "server", "await": { "event": "stream_opened", "id": 3 } },
    { "actor": "server", "cmd": { "cmd": "open_stream" } },
    { "actor": "server", "await": { "event": "stream_opened", "id": 5 } },

    { "actor": "client", "await": { "event": "stream_opened", "id": 1 } },
    { "actor": "client", "await": { "event": "stream_opened", "id": 3 } },
    { "actor": "client", "await": { "event": "stream_opened", "id": 5 } },

    { "actor": "server", "cmd": { "cmd": "write", "id": 1, "data_b64": "cmVxLTE=" } },
    { "actor": "client", "await": { "event": "data", "id": 1, "data_b64": "cmVxLTE=" } },
    { "actor": "server", "cmd": { "cmd": "write", "id": 3, "data_b64": "cmVxLTM=" } },
    { "actor": "client", "await": { "event": "data", "id": 3, "data_b64": "cmVxLTM=" } },
    { "actor": "server", "cmd": { "cmd": "write", "id": 5, "data_b64": "cmVxLTU=" } },
    { "actor": "client", "await": { "event": "data", "id": 5, "data_b64": "cmVxLTU=" } },

    { "actor": "server", "cmd": { "cmd": "close_write", "id": 1 } },
    { "actor": "server", "cmd": { "cmd": "close_write", "id": 3 } },
    { "actor": "server", "cmd": { "cmd": "close_write", "id": 5 } },
    { "actor": "client", "await": { "event": "stream_closed", "id": 1, "direction": "read" } },
    { "actor": "client", "await": { "event": "stream_closed", "id": 3, "direction": "read" } },
    { "actor": "client", "await": { "event": "stream_closed", "id": 5, "direction": "read" } },

    { "actor": "client", "cmd": { "cmd": "write", "id": 1, "data_b64": "cmVzcC0x" } },
    { "actor": "server", "await": { "event": "data", "id": 1, "data_b64": "cmVzcC0x" } },
    { "actor": "client", "cmd": { "cmd": "write", "id": 3, "data_b64": "cmVzcC0z" } },
    { "actor": "server", "await": { "event": "data", "id": 3, "data_b64": "cmVzcC0z" } },
    { "actor": "client", "cmd": { "cmd": "write", "id": 5, "data_b64": "cmVzcC01" } },
    { "actor": "server", "await": { "event": "data", "id": 5, "data_b64": "cmVzcC01" } },

    { "actor": "client", "cmd": { "cmd": "close_write", "id": 1 } },
    { "actor": "client", "cmd": { "cmd": "close_write", "id": 3 } },
    { "actor": "client", "cmd": { "cmd": "close_write", "id": 5 } },
    { "actor": "server", "await": { "event": "stream_closed", "id": 1, "direction": "read" } },
    { "actor": "server", "await": { "event": "stream_closed", "id": 3, "direction": "read" } },
    { "actor": "server", "await": { "event": "stream_closed", "id": 5, "direction": "read" } }
  ]
}
