      "gamma": { "state": "disabled", "id": "srv_gamma", "code": "DISABLED", "lastError": "This service is disabled in the mcpwarp dashboard." },
      "delta": { "state": "disabled", "id": "srv_delta" },
      "epsilon": { "state": "active", "id": "srv_epsilon", "url": "https://epsilon-tester.mcpwarp.test/mcp" }
    } },
    { "state": "online", "services": {
      "alpha": { "state": "active", "id": "srv_alpha", "url": "https://alpha-tester.mcpwarp.test/mcp" },
      "beta": { "state": "rejected", "code": "CONFLICT", "lastError": "The name is in use by another server." },
      "gamma": { "state": "disabled", "id": "srv_gamma", "code": "DISABLED", "lastError": "This service is disabled in the mcpwarp dashboard." },
      "delta": { "state": "disabled", "id": "srv_delta" },
