{
  "description": "An app message sent by the server, and an independent one received from the client, both after welcome. ws-mixer does not parse, validate or transform body -- it is delivered verbatim to the application on both ends. OVERVIEW.md section 2.7 decision 4.",
  "role": "server",
  "steps": [
    { "recv": { "t": "hello", "v": 1, "token": "eyJhbGciOi.abc", "agent": { "sdk": "ws-mixer-js", "sdk_version": "0.3.1" } } },
    { "send": { "t": "welcome", "v": 1, "session": "01J8Z2K9QF3M4N5P6R7S8T9V0W", "window": 262144, "max_streams": 64, "ping_interval": 30000, "ping_timeout": 90000 } },
    { "send": { "t": "app", "body": { "mcpwarp": { "v": 1, "op": "register", "services": [{ "id": "anki", "name": "Anki MCP" }] } } } },
    { "recv": { "t": "app", "body": { "mcpwarp": { "v": 1, "op": "register", "services": [{ "id": "anki", "name": "Anki MCP" }] } } } },
    { "expect": { "error_code": null } }
  ]
}
