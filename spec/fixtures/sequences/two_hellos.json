{
  "description": "A second hello arrives on a connection that already completed its handshake. OVERVIEW.md section 2.9: 'A second hello on the same connection is a PROTOCOL_ERROR.'",
  "role": "server",
  "steps": [
    { "recv": { "t": "hello", "v": 1, "token": "eyJhbGciOi.abc", "agent": { "sdk": "ws-mixer-js", "sdk_version": "0.3.1" } } },
    { "send": { "t": "welcome", "v": 1, "session": "01J8Z2K9QF3M4N5P6R7S8T9V0W", "window": 262144, "max_streams": 64, "ping_interval": 30000, "ping_timeout": 90000 } },
    { "recv": { "t": "hello", "v": 1, "token": "eyJhbGciOi.abc", "agent": { "sdk": "ws-mixer-js", "sdk_version": "0.3.1" } } },
    { "send": { "t": "error", "code": 1, "message": "second hello received after welcome already sent" } },
    { "expect": { "error_code": "PROTOCOL_ERROR", "close_code": 4001 } }
  ]
}
